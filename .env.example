# Neon Postgres (Prisma). Both values can point to the pooler URL.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Optional integrations — the app works without any of these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated verified identities allowed to access /admin in production.
PLATFORM_ADMIN_EMAILS=

# Customer OTP email delivery. Without this the OTP is returned in the API
# response so sign-in works locally without paid credentials.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=LocalShop AI <onboarding@resend.dev>

# Session signing secrets. Fixed dev defaults are used when left blank in
# development; in production these MUST be set or session signing fails.
CUSTOMER_SESSION_SECRET=
MERCHANT_SESSION_SECRET=
