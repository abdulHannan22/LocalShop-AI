# The app runs without credentials using deterministic intent extraction and a
# safe checkout simulation. Add these values to enable real integrations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated verified identities allowed to access /admin in production.
# The first authenticated user can bootstrap the initial owner/admin account.
PLATFORM_ADMIN_EMAILS=

# Customer sign-in (email OTP). Without RESEND_API_KEY the app runs in safe
# local/demo mode: the OTP is returned directly in the API response instead
# of being emailed, so sign-in still works without paid credentials.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=LocalShop AI <onboarding@resend.dev>
# Secret used to sign customer session cookies. Set a long random value in
# production; a fixed development default is used if left blank locally.
CUSTOMER_SESSION_SECRET=

# Local development identity only; hosted production uses verified user headers.
DEV_USER_EMAIL=owner@nova.local
DEV_USER_NAME=Nova Store Owner
