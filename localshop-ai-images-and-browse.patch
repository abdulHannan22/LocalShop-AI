diff --git a/app/globals.css b/app/globals.css
index 2955689..c91caf6 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -718,6 +718,13 @@ button { cursor: pointer; }
 .store-product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
 .store-product-grid article { overflow: hidden; border: 1px solid #dfe5dc; border-radius: 17px; background: #fff; transition: .16s ease; }
 .store-product-grid article.chosen { border-color: #4f805c; box-shadow: 0 0 0 3px rgba(79,128,92,.12); }
+.store-browse { margin-top: 34px; padding-top: 30px; border-top: 1px solid var(--line); }
+.store-browse-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 18px; }
+.store-browse-controls input[type="search"] { min-width: 220px; height: 38px; padding: 0 13px; border: 1px solid #dfe5dc; border-radius: 10px; font-size: 11px; }
+.store-category-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.store-category-chips button { padding: 7px 12px; border: 1px solid #dfe5dc; border-radius: 999px; background: #fff; color: #52645a; font-size: 9px; font-weight: 800; cursor: pointer; }
+.store-category-chips button.active { background: var(--forest); border-color: var(--forest); color: #fff; }
+.store-browse-empty { padding: 20px; color: #667169; font-size: 11px; }
 .store-product-art { position: relative; min-height: 110px; display: flex; justify-content: space-between; align-items: flex-start; padding: 13px; overflow: hidden; }
 .store-product-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
 .store-product-art span, .store-product-art b { position: relative; z-index: 1; }
