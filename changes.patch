diff --git a/app/api/customer/auth/request/route.ts b/app/api/customer/auth/request/route.ts
new file mode 100644
index 0000000..27d5f45
--- /dev/null
+++ b/app/api/customer/auth/request/route.ts
@@ -0,0 +1,29 @@
+import { requestCustomerOtp } from "../../../../../lib/customer-auth";
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export async function POST(request: Request) {
+  let payload: { email?: string };
+  try {
+    payload = (await request.json()) as typeof payload;
+  } catch {
+    return Response.json({ error: "Request body must be valid JSON." }, { status: 400 });
+  }
+
+  const email = payload.email?.trim() ?? "";
+  if (!EMAIL_PATTERN.test(email)) {
+    return Response.json({ error: "Enter a valid email address." }, { status: 400 });
+  }
+
+  const result = await requestCustomerOtp(email);
+
+  return Response.json({
+    message: result.sent
+      ? "We sent a 6-digit code to your email."
+      : "Local demo mode: no email provider configured, so here is your code directly.",
+    // Only present when no transactional email provider (RESEND_API_KEY) is
+    // configured — mirrors the app's existing "safe simulation" behaviour
+    // for Razorpay when live credentials are absent.
+    devCode: result.devCode,
+  });
+}
diff --git a/app/api/customer/auth/verify/route.ts b/app/api/customer/auth/verify/route.ts
new file mode 100644
index 0000000..6a64c81
--- /dev/null
+++ b/app/api/customer/auth/verify/route.ts
@@ -0,0 +1,27 @@
+import { customerSessionCookieHeader, signCustomerSession, verifyCustomerOtp } from "../../../../../lib/customer-auth";
+
+export async function POST(request: Request) {
+  let payload: { email?: string; code?: string };
+  try {
+    payload = (await request.json()) as typeof payload;
+  } catch {
+    return Response.json({ error: "Request body must be valid JSON." }, { status: 400 });
+  }
+
+  const email = payload.email?.trim() ?? "";
+  const code = payload.code?.trim() ?? "";
+  if (!email || !/^\d{6}$/.test(code)) {
+    return Response.json({ error: "Enter the 6-digit code sent to your email." }, { status: 400 });
+  }
+
+  const customer = await verifyCustomerOtp(email, code);
+  if (!customer) {
+    return Response.json({ error: "That code is invalid or has expired." }, { status: 401 });
+  }
+
+  const { token, maxAge } = await signCustomerSession(customer.id);
+  return Response.json(
+    { customer },
+    { headers: { "Set-Cookie": customerSessionCookieHeader(token, maxAge) } },
+  );
+}
